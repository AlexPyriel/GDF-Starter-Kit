{
  "mcpServers": {
    "unityMCP": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--offline", "--from", "mcpforunityserver==9.6.8", "mcp-for-unity", "--transport", "stdio"]
    },
    "serena": {
      "type": "stdio",
      "command": "/usr/local/bin/uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--open-web-dashboard",
        "False"
      ],
      "env": {}
    }
  }
}
